# Server-only. Set these on Vercel → Settings → Environment Variables.
# Never prefix STRIPE_SECRET_KEY with VITE_ (that would expose it in the browser).
STRIPE_SECRET_KEY=
PUBLIC_SITE_URL=https://www.proximatedate.com

# Private /stats page. Never prefix with VITE_. Open /stats?key= this value.
STATS_KEY=

# Hide the Vercel Toolbar / comments / draft bubble (documented Vercel env).
# Also set the project dashboard: Settings → General → Vercel Toolbar → Production: Off.
VERCEL_PREVIEW_FEEDBACK_ENABLED=0

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!api/|videos/|images/|audio/|favicon.svg|icons.svg|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "x-vercel-skip-toolbar", "value": "1" },
        { "key": "x-vercel-toolbar", "value": "0" }
      ]
    }
  ]
}
